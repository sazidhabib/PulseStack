    "lint": "echo 'no lint for db'"
  },
  "dependencies": {
    "@pulsestack/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.39.3",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@pulsestack/tsconfig": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.30.5",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2"
  }
}
