# Database
DATABASE_URL=postgresql://pulsestack:pulsestack@localhost:5432/pulsestack

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=your-access-secret-min-32-chars-long-development
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-long-development
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# API
API_PORT=4000
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Worker
CONCURRENCY=10

# Frontend (Public)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
